# Supabase Postgres
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://192.168.0.4:3000
